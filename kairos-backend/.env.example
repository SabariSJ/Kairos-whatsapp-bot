# ==============================================================================
# KAIROS BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your actual environment variables.
# Never commit actual credentials or passwords to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database - AWS RDS PostgreSQL (devdb)
DB_HOST=kairos-dev-db.cstyogquglrh.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=devdb
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL=true

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# Security & JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret_min_32_characters
JWT_EXPIRES_IN=1h
INTERNAL_SERVICE_KEY=your_internal_service_key_for_bot_to_backend_sync

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000,http://localhost:5000

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20

# Staff Accounts Configuration (Bcrypt Hash Stored in Environment)
# Generated using bcrypt with salt rounds 10
PAYMENT_STAFF_EMAIL=payment@sprout.com
PAYMENT_STAFF_DISPLAY_NAME=Payment Team
PAYMENT_STAFF_ROLE=payment_staff
PAYMENT_STAFF_PASSWORD_HASH=GENERATED_BCRYPT_HASH

REPORT_STAFF_EMAIL=report@sprout.com
REPORT_STAFF_DISPLAY_NAME=Report Team
REPORT_STAFF_ROLE=report_staff
REPORT_STAFF_PASSWORD_HASH=GENERATED_BCRYPT_HASH
