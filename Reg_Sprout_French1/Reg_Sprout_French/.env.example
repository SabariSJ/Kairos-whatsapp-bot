# Firebase Spark Plan Web Configuration
# Obtenez ces valeurs depuis la console Firebase (Paramètres du projet > Applications Web)
# Note : Aucune carte bancaire ni plan payant Blaze n'est requis.

VITE_FIREBASE_API_KEY=votre_api_key_ici
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet-id
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Common Backend API URL (Phase 2 / Phase 4 Integration)
VITE_API_BASE_URL=http://localhost:5000/api

